      "source": [
        "#Check whether a given number is prime or non-prime\n",
        "n=int(input(\"Enter a Number:\"))\n",
        "c=0\n",
        "for i in range(1,n+1):\n",
        "    if n%i==0:\n",
        "        c+=1\n",
        "if c==2:\n",
        "    print(n,\"It is a Prime Number\")\n",
        "else:\n",
        "    print(n,\"It is not a Prime Number\")\n",
        "# Prime numbers within an interval using for loop\n",
        "for i in range(1,101):\n",
        "    c=0\n",
        "    for j in range(1,i+1):\n",
        "        if i % j == 0:\n",
        "            c+=1\n",
        "    if c==2:\n",
        "        print(i)\n",
        "#Prime numbers within an interval using while loop\n",
        "i=1\n",
        "while i<100:\n",
        "    i+=1\n",
        "    c=0\n",
        "    for j in range(1,i+1):\n",
        "        if i % j == 0:\n",
        "          c+=1\n",
        "    if c==2:\n",
        "        print(i)"
